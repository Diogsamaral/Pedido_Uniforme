generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PerfilCodigo {
  ADMINISTRADOR
  COMERCIAL
  PRODUCAO
  FINANCEIRO
}

model Empresa {
  id            String   @id @default(uuid())

  nome          String
  nomeFantasia  String?

  cnpj          String?  @unique

  email         String?

  cidade        String?
  estado        String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  usuarios      Usuario[]
  clientes      Cliente[]

  produtos      Produto[]

  configuracao  ConfiguracaoEmpresa?

  @@map("empresas")
}

model ConfiguracaoEmpresa {
  id                     String   @id @default(uuid())

  empresaId              String   @unique

  empresa                Empresa  @relation(fields: [empresaId], references: [id])

  quantidadeMinimaPedido Int      @default(20)

  valorAplicacao         Decimal  @db.Decimal(12,2)

  descontoPix            Decimal  @db.Decimal(5,2)

  acrescimoCartao        Decimal  @db.Decimal(5,2)

  prazoEntregaDiasMin    Int
  prazoEntregaDiasMax    Int

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("configuracoes_empresa")
}

model Perfil {
  id          Int           @id @default(autoincrement())

  codigo      PerfilCodigo  @unique

  descricao   String?

  createdAt   DateTime      @default(now())

  usuarios    UsuarioPerfil[]

  @@map("perfis")
}

model Usuario {
  id            String   @id @default(uuid())

  empresaId     String

  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  nome          String

  email         String   @unique

  senhaHash     String

  ativo         Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  perfis        UsuarioPerfil[]

  @@map("usuarios")
}

model UsuarioPerfil {
  usuarioId     String

  perfilId      Int

  usuario       Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  perfil        Perfil  @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  atribuidoEm   DateTime @default(now())

  @@id([usuarioId, perfilId])

  @@map("usuarios_perfis")
}

model Cliente {
  id                String   @id @default(uuid())

  empresaId         String

  empresa           Empresa  @relation(fields: [empresaId], references: [id])

  razaoSocial       String

  nomeFantasia      String?

  cnpj              String   @unique

  email             String?

  telefone          String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contatos          ContatoCliente[]

  @@map("clientes")
}

model ContatoCliente {
  id                String   @id @default(uuid())

  clienteId         String

  cliente           Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  nome              String

  cargo             String?

  email             String?

  telefone          String?

  principal         Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("contatos_cliente")
}

model FormaPagamento {
  id                     Int      @id @default(autoincrement())

  descricao              String   @unique

  descontoPercentual     Decimal  @default(0) @db.Decimal(5,2)

  acrescimoPercentual    Decimal  @default(0) @db.Decimal(5,2)

  ativo                  Boolean  @default(true)

  @@map("formas_pagamento")
}

model TipoAplicacao {
  id          Int      @id @default(autoincrement())

  nome        String   @unique

  @@map("tipos_aplicacao")
}

model LocalAplicacao {
  id          Int      @id @default(autoincrement())

  nome        String   @unique

  @@map("locais_aplicacao")
}

model Produto {
  id            String   @id @default(uuid())

  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])

  nome          String

  descricao     String?

  ativo         Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  precos        TabelaPreco[]

  @@map("produtos")
}

model TabelaPreco {
  id                String   @id @default(uuid())

  produtoId         String

  produto           Produto
      @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  quantidadeMin     Int

  quantidadeMax     Int

  precoUnitario     Decimal @db.Decimal(10,2)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("tabela_precos")
}